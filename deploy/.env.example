# Tailscale 내부 테스트에서는 :80을 사용합니다.
# 도메인 연결 후에는 pingpong.example.com 형태로 변경합니다.
APP_ADDRESS=:80

# 실제 운영 환경에서는 openssl rand -hex 16 결과로 교체합니다.
PB_ENCRYPTION_KEY=replace_with_32_random_characters

PB_DATA_PATH=/srv/data/somoim-pingpong/pocketbase
CADDY_DATA_PATH=/srv/data/somoim-pingpong/caddy/data
CADDY_CONFIG_PATH=/srv/data/somoim-pingpong/caddy/config